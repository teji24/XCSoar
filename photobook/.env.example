# Copier en .env puis adapter.

# Service de génération PDF. Avec Docker Compose : http://gotenberg:3000
# Laisser vide pour utiliser un Chromium local (CHROMIUM_BIN).
GOTENBERG_URL=http://gotenberg:3000
CHROMIUM_BIN=

# Fond de carte (tuiles raster XYZ). {s} {z} {x} {y} et {r} (suffixe @2x) sont remplacés.
# Le serveur public d'OpenStreetMap n'accepte qu'un usage léger : pour un usage
# régulier, préférer MapTiler / Stadia / Thunderforest (clé gratuite) ou vos propres tuiles.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_RETINA=0
TILE_ATTRIBUTION=© OpenStreetMap contributors

# Géocodage inverse (noms des villes). Limité à 1 requête/seconde, résultats mis en cache.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Adresse de contact envoyée dans le User-Agent (exigée par OSM).
CONTACT_EMAIL=

# Immich (facultatif) : URL du serveur et clé API (Paramètres du compte > Clés API).
IMMICH_URL=
IMMICH_API_KEY=
